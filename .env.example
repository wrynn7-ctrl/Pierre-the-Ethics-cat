# Copy this file to .env and fill it in. Never commit .env.
# Only needed for AI mode (the behind-the-scenes switch).
ANTHROPIC_API_KEY=
# Optional: "jokes" or "ai". Overrides pierre.config.json.
PIERRE_MODE=
# Optional: model used in AI mode (default claude-haiku-5-5).
PIERRE_MODEL=
# Optional: port to listen on (default 3000).
PORT=
